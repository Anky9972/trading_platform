# Copy to .env and fill in values. NEVER commit actual values to git.
ANGEL_API_KEY=
ANGEL_CLIENT_ID=
ANGEL_PASSWORD=
ANGEL_TOTP_SECRET=
TRADING_MODE=paper
MAX_CAPITAL=500000
TRADING_DB=trading.db
KILL_SWITCH_FILE=.kill_switch
HEARTBEAT_FILE=.engine_heartbeat
PID_FILE=.engine.pid
SESSION_FILE=.broker_session
SOCKET_PATH=/tmp/trading_engine.sock
